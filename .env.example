APP_NAME=larawebkit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# larawebkit. Every value below is optional; features without keys are hidden.
# Never commit real keys: this file is public.
# ---------------------------------------------------------------------------

# Admin panel URL path and whether every admin must set up TOTP 2FA.
ADMIN_PATH=admin
ADMIN_REQUIRE_2FA=false

# Security headers / public forms
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_FRONT_CSP=
PUBLIC_FORM_RATE_LIMIT=5

# Media pipeline (all images are converted to WebP)
MEDIA_IMAGE_DRIVER=auto
MEDIA_DISK=public
MEDIA_ORIGINAL_DISK=local
MEDIA_QUALITY=80
MEDIA_MAX_UPLOAD_KB=10240
MEDIA_MAX_MEGAPIXELS=40
MEDIA_OG_FORMAT=webp

# Themes (themes/{name}). Zip upload runs third-party PHP (Blade): keep it off unless you need it.
THEMES_ALLOW_UPLOAD=false
THEMES_MAX_UPLOAD_MB=20

# Forms: largest file upload (KB) and how long signed download links work (hours)
FORMS_MAX_FILE_KB=10240
DOWNLOAD_LINK_HOURS=72

# Newsletter: e-mails per minute while a campaign is sending (check your host's mail limits)
NEWSLETTER_BATCH_SIZE=50

# Content editor
EDITOR_AUTOSAVE_SECONDS=30
EDITOR_PUBLISH_GATE=true

# Pexels stock photos (https://www.pexels.com/api/)
PEXELS_API_KEY=

# AI assistant: providers are tried in this order, the first with a key wins.
AI_PROVIDERS=anthropic,openai,deepseek,ollama
AI_TIMEOUT=120
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
ANTHROPIC_MODEL_STRONG=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHEAP=deepseek-chat
DEEPSEEK_MODEL_STRONG=deepseek-chat
# Local OpenAI-compatible server, e.g. http://localhost:11434/v1 for Ollama
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1

# SEO
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
ROBOTS_BLOCK_NON_PRODUCTION=true
PAGE_CACHE_STORE=file
PAGE_CACHE_TTL=3600

# Mail providers (only if you use them)
POSTMARK_API_KEY=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
